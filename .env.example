# Copy this file to .env and fill in your values. Never commit .env.

# --- AI model (free option: Groq, https://console.groq.com/keys) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# OpenAI instead:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini

# --- Google Sheet ---
GOOGLE_CREDENTIALS_FILE=credentials.json
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- Email finder (optional, free tier at https://hunter.io) ---
HUNTER_API_KEY=

# --- Email sending: Mailtrap Email Sandbox (catches emails, delivers nothing) ---
# Leave SMTP_HOST empty to only print emails in the terminal (dry run).
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=bdr@gopratle.test
FROM_NAME=Your Name
# Safety: every email goes here instead of the real lead.
TEST_RECIPIENT=test-inbox@example.com

# --- Telegram bot (optional, create one with @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Timing ---
# 2 minutes for the demo video. In real life use 4320 (3 days).
FOLLOWUP_DELAY_MINUTES=2
POLL_SECONDS=15
